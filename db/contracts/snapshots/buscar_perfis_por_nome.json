        { "name": "avatar_path", "type": "TEXT" },
        { "name": "updated_at",  "type": "TIMESTAMPTZ" }
      ]
    },
    "language": "plpgsql",
    "securityDefiner": true
  },
  "errors": [],
  "limits": {
    "p_limite": { "min": 1, "max": 50, "enforced": true }
  },
  "examples": {
    "validInput": { "p_termo": "João", "p_limite": 10 },
    "expectedOutputFields": ["id", "full_name", "avatar_path", "updated_at"]
  },
  "grants": ["authenticated"],
  "migration": "20260503000002_modal_rpc_functions.sql"
}

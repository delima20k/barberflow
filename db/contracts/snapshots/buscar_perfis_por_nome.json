    "params": [
      { "name": "p_termo",  "type": "TEXT" },
      { "name": "p_limite", "type": "INT", "default": "20" }
    ],
    "returns": {
      "type": "TABLE",
      "columns": [
        { "name": "id",          "type": "UUID" },

# BFF BarberFlow — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commitar o .env com valores reais.

# ── Servidor ─────────────────────────────────────────────────────
PORT=3002
APP_ENV=development   # development | staging | production
LOG_LEVEL=debug       # debug | info | warn | error

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
# Chave de serviço (Settings > API > service_role). Nunca expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=
# Chave pública anônima (Settings > API > anon). Obrigatória para AuthRepository.
SUPABASE_ANON_KEY=
# JWT secret do projeto (Settings > API > JWT Settings).
# Quando presente, verificação de token é local (zero latência).
# Quando ausente, fallback para supabase.auth.getUser() via rede.
SUPABASE_JWT_SECRET=

# ── Timeouts ─────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# ── Geo ───────────────────────────────────────────────────────────
GEO_TTL_MS=3600000  # TTL em ms da posição GPS do usuário (padrão: 1 hora)

# ── Rate Limit Redis (Upstash) ───────────────────────────────────
# Quando configurado, rate limiting é compartilhado entre todas as instâncias
# serverless (Vercel). Sem essas vars, usa MemoryStore (dev/staging).
# Obtenha em: https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Web Push (VAPID) ─────────────────────────────────────────────
# Mesmas chaves usadas nos Supabase Secrets para a Edge Function send-push.
# VAPID_PUBLIC_KEY deve ser idêntica ao #VAPID_PUBLIC de shared/js/PushSubscriptionService.js
# Obtenha a privada em: Supabase Dashboard → Settings → Secrets → VAPID_PRIVATE_KEY
VAPID_PUBLIC_KEY=BEo5j2EmjmOF-g2i269onWjpSzFkwe-M8GSZxWMCLJHQNUSkYNOzacir--SFYel56cKM_kWNhSa2-mu2IGNmNP0
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@barberflow.app

# BFF BarberFlow — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commitar o .env com valores reais.

# ── Servidor ─────────────────────────────────────────────────────
PORT=3002
APP_ENV=development   # development | staging | production
LOG_LEVEL=debug       # debug | info | warn | error

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret do projeto Supabase (Settings > API > JWT Settings)
# Quando presente, verificação de token é feita localmente (zero latência).
# Quando ausente, fallback para supabase.auth.getUser() via rede.
SUPABASE_JWT_SECRET=

# ── Timeouts ─────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

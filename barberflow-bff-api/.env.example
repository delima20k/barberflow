# BFF BarberFlow — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commitar o .env com valores reais.

# ── Servidor ─────────────────────────────────────────────────────
PORT=3002
APP_ENV=development   # development | staging | production
LOG_LEVEL=debug       # debug | info | warn | error

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
# Chave de serviço (Settings > API > service_role). Nunca expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=
# Chave pública anônima (Settings > API > anon). Obrigatória para AuthRepository.
SUPABASE_ANON_KEY=
# JWT secret do projeto (Settings > API > JWT Settings).
# Quando presente, verificação de token é local (zero latência).
# Quando ausente, fallback para supabase.auth.getUser() via rede.
SUPABASE_JWT_SECRET=

# ── Timeouts ─────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# ── Geo ───────────────────────────────────────────────────────────
GEO_TTL_MS=3600000  # TTL em ms da posição GPS do usuário (padrão: 1 hora)

# ── Rate Limit Redis (Upstash) ───────────────────────────────────
# Quando configurado, rate limiting é compartilhado entre todas as instâncias
# serverless (Vercel). Sem essas vars, usa MemoryStore (dev/staging).
# Obtenha em: https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Web Push (VAPID) ─────────────────────────────────────────────
# Mesmas chaves usadas nos Supabase Secrets para a Edge Function send-push.
# VAPID_PUBLIC_KEY deve ser idêntica ao #VAPID_PUBLIC de shared/js/PushSubscriptionService.js
# Obtenha a privada em: Supabase Dashboard → Settings → Secrets → VAPID_PRIVATE_KEY
VAPID_PUBLIC_KEY=BEo5j2EmjmOF-g2i269onWjpSzFkwe-M8GSZxWMCLJHQNUSkYNOzacir--SFYel56cKM_kWNhSa2-mu2IGNmNP0
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@barberflow.app

# ── Painel Admin — Criptografia ──────────────────────────────
# Chave AES-256-GCM para criptografar credenciais de storage no banco.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 64 caracteres hex (32 bytes). OBRIGATÓRIO em produção.
ADMIN_ENCRYPT_KEY=

# ── Cloudflare R2 ────────────────────────────────────────────
# Configurável via painel admin (admin.html → Configurações → Cloudflare R2).
# Os valores abaixo são carregados do banco criptografado no startup do BFF.
# Defini-los aqui também funciona e tem prioridade caso o banco esteja vazio.
#
# Obtenha em: Cloudflare Dashboard → R2 → Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=         # ex: https://pub-xxx.r2.dev (URL pública do bucket)

# ── Media Pipeline ────────────────────────────────────────────
# Secret HMAC para assinatura dos tokens de confirmação de upload.
# Gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Configurável via painel admin (botão "Gerar automaticamente").
MEDIA_CONFIRM_SECRET=

# Backend de storage para stories: 'r2' (Cloudflare R2) ou 'supabase'.
# Configurável via painel admin. Padrão: r2
STORIES_STORAGE_BACKEND=r2

# ── Asaas (pagamentos do app profissional) ─────────────────────────────────
# Configure somente no BFF/Vercel. Nunca expor ASAAS_API_KEY no frontend.
# ASAAS_ENV: sandbox | production
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_BASE_URL=https://sandbox.asaas.com/api
# Token secreto que o Asaas envia no header "asaas-access-token" do webhook.
# Gerar valor forte e configurar também no painel do Asaas.
ASAAS_WEBHOOK_TOKEN=
ASAAS_TIMEOUT_MS=60000

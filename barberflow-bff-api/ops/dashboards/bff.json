{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "BFF BarberFlow Prometheus datasource",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" }
  ],
  "title": "BFF BarberFlow — Observabilidade",
  "uid":   "bff-barberflow-obs",
  "tags":  ["barberflow", "bff", "observability"],
  "time":  { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Requests/s",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "sum(rate(bff_http_requests_total[1m]))",
        "legendFormat": "req/s"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 2, "type": "stat", "title": "Error rate (%)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "100 * sum(rate(bff_http_errors_total[5m])) / sum(rate(bff_http_requests_total[5m]))",
        "legendFormat": "error %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 3, "type": "stat", "title": "WS Connections",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "bff_ws_connections_current",
        "legendFormat": "conexões"
      }]
    },
    {
      "id": 4, "type": "stat", "title": "Cache Hit Rate (%)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "100 * sum(rate(bff_cache_hits_total[5m])) / (sum(rate(bff_cache_hits_total[5m])) + sum(rate(bff_cache_misses_total[5m])))",
        "legendFormat": "hit %"
      }],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 5, "type": "stat", "title": "Uploads/s",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "sum(rate(bff_uploads_total[1m]))",
        "legendFormat": "uploads/s"
      }]
    },
    {
      "id": 6, "type": "timeseries", "title": "Latência HTTP — p50 / p99 (ms)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.50, sum by(le)(rate(bff_http_request_duration_ms_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.99, sum by(le)(rate(bff_http_request_duration_ms_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Requests/s por status",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by(status_code)(rate(bff_http_requests_total[1m]))",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "id": 8, "type": "gauge", "title": "Heap Usage (%)",
      "gridPos": { "x": 0, "y": 12, "w": 6, "h": 6 },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "100 * bff_node_heap_used_bytes / bff_node_heap_size_bytes",
        "legendFormat": "heap %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 85 }
            ]
          }
        }
      }
    },
    {
      "id": 9, "type": "gauge", "title": "Event Loop Lag (ms)",
      "gridPos": { "x": 6, "y": 12, "w": 6, "h": 6 },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "bff_node_eventloop_lag_seconds_mean * 1000",
        "legendFormat": "lag ms"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 10, "type": "timeseries", "title": "Filas — Jobs por status",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 6 },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by(queue,status)(rate(bff_queue_jobs_total[1m]))",
          "legendFormat": "{{queue}} / {{status}}"
        }
      ]
    },
    {
      "id": 11, "type": "barchart", "title": "Top Endpoints por Volume",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 6 },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "topk(10, sum by(method,route)(rate(bff_http_requests_total[5m])))",
        "legendFormat": "{{method}} {{route}}"
      }]
    }
  ]
}

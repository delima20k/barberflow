{
  "version": 2,
  "regions": ["gru1"],
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/internal/cron/stories-cleanup",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "app.js,config/**,controllers/**,domain/**,application/**,infrastructure/**,observability/**,middlewares/**,repositories/**,routes/**,services/**,utils/**,validators/**,../shared/**,../src/infra/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, must-revalidate" },
        { "key": "Vary",          "value": "Origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}

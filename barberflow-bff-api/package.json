{
  "name": "@barberflow/barberflow-bff-api",
  "version": "1.0.0",
  "description": "API central compartilhada (BFF) para os apps cliente e profissional do BarberFlow",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/app.test.js tests/health.test.js tests/middlewares.test.js tests/barbearia.test.js tests/geo.test.js tests/push-barbeiro.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:e2e": "node --test tests/e2e/*.e2e.test.js",
    "test:contract": "node --test tests/contract/*.contract.test.js",
    "test:coverage": "node --experimental-test-coverage --test tests/unit/**/*.test.js tests/*.test.js",
    "test:mutation": "npx stryker run",
    "test:all": "node --test tests/**/*.test.js",
    "predeploy": "node scripts/pre-deploy.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:bff": "node scripts/validate-bff.js",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@sentry/node": "^10.53.1",
    "@supabase/supabase-js": "^2.106.2",
    "@upstash/redis": "^1.34.9",
    "awilix": "^12.0.4",
    "bullmq": "^5.77.3",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-plugin-n": "^17.15.0",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2"
  },
  "private": true,
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}

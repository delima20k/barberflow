# BarberFlow write smoke env example.
# Safe placeholders only. Do not put real tokens in this file.
#
# Copy values into your local shell session or into a local ignored file such as:
#   load-tests/write/.env.local
#
# Never commit real JWTs, passwords, service_role keys, or production user data.

LOADTEST_BASE_URL=https://bff.berberflow.shop
LOADTEST_ENABLE_WRITES=true
LOADTEST_ENABLE_PUSH=false
LOADTEST_RUN_ID=loadtest_write_YYYYMMDD_HHMMSS

# JWTs from BFF login with TEST users only.
# Source: POST https://bff.berberflow.shop/api/auth/login
LOADTEST_CLIENT_TOKEN=ey_test_client_access_token_here
LOADTEST_PROFESSIONAL_TOKEN=ey_test_professional_access_token_here

# IDs from Supabase test data or from BFF/app responses for TEST records only.
LOADTEST_BARBERSHOP_ID=00000000-0000-4000-8000-000000000001
LOADTEST_PROFESSIONAL_ID=00000000-0000-4000-8000-000000000002
LOADTEST_SERVICE_ID=00000000-0000-4000-8000-000000000003

# Use one of these for chat.
# Preferred: reuse an existing test conversation.
LOADTEST_CONVERSATION_ID=00000000-0000-4000-8000-000000000004

# Alternative: omit LOADTEST_CONVERSATION_ID and use a test peer user id.
# The harness can create/reuse a direct conversation through the BFF.
LOADTEST_PEER_USER_ID=

# Optional but recommended to avoid schedule conflicts.
# Must be a future slot reserved for load tests in the test barbershop.
LOADTEST_SCHEDULED_AT=2026-06-12T15:00:00.000Z
LOADTEST_APPOINTMENT_DURATION_MIN=30
LOADTEST_PRICE_CHARGED=50

# Cleanup is dry-run by default. Real cleanup requires explicit later authorization.
LOADTEST_CLEANUP_CONFIRM=
